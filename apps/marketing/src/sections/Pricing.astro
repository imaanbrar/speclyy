---
const plans = [
  {
    name:     'Trial',
    price:    '0',
    period:   'for 7 days',
    note:     'Full access. No credit card required.',
    cta:      'Start trial',
    ctaHref:  'https://app.speclyy.com/sign-up',
    featured: false,
    features: [
      'Unlimited projects',
      'URL paste + manual entry',
      'Full Library access',
      'PDF export',
    ],
  },
  {
    name:     'Studio',
    price:    '39',
    period:   '/ designer / month',
    note:     'Flat rate. Cancel anytime.',
    cta:      'Start free trial',
    ctaHref:  'https://app.speclyy.com/sign-up',
    featured: true,
    features: [
      'Everything in Trial',
      'My Library (save & reuse)',
      'Studio branding on exports',
      'CSV export for trades',
    ],
  },
]
---

<section id="pricing" class="ds-section bg-app">
  <div class="ds-container">
    <div class="max-w-2xl mb-16">
      <p class="eyebrow mb-4">Pricing</p>
      <h2 class="h2 md:text-40 lg:text-48">
        One tier. <span class="italic-serif">Seven-day</span> trial.
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2 max-w-4xl">
      {plans.map(plan => (
        <div class={`rounded-lg p-9 border bg-surface ${plan.featured ? 'bg-subtle border-ink-900 border-[1.5px]' : 'border-[color:var(--border-2)]'}`}>
          <p class="eyebrow mb-2">{plan.name}</p>
          <div class="flex items-baseline gap-2 my-4">
            <span class="font-display font-normal text-64 md:text-80 leading-none tracking-tighter">
              <span class="align-super text-32 md:text-40 mr-0.5">$</span>{plan.price}
            </span>
            <span class="caption">{plan.period}</span>
          </div>
          <p class="body-sm text-ink-500 mt-0">{plan.note}</p>

          <ul class="mt-6 mb-8 flex flex-col gap-2.5">
            {plan.features.map(f => (
              <li class="flex gap-2.5 items-start body-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent flex-shrink-0 mt-0.5">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a href={plan.ctaHref} class={`btn btn-block ${plan.featured ? 'btn-primary' : 'btn-ghost'}`}>
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
