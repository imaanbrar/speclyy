---
const pains = [
  {
    heading: 'Specs live in a dozen places.',
    body: 'Sticky notes, Excel, Programa, email threads. You spend more time hunting for specs than presenting them.',
  },
  {
    heading: 'Research is 70% copy-paste.',
    body: "You find a Delta faucet you love, then manually transcribe the finish, SKU, and dimensions from the vendor's site. Every. Single. Product.",
  },
  {
    heading: "Clients ask for updates you can't quickly give.",
    body: 'The spec sheet is out of date the moment you share it. Changes mean tracking down the original, editing, and re-exporting.',
  },
]
---

<section class="ds-section bg-subtle">
  <div class="ds-container">
    <div class="max-w-2xl mb-16">
      <p class="eyebrow mb-4">The problem</p>
      <h2 class="h2 md:text-40 lg:text-48">
        Interior design is creative work.<br />
        <span class="italic-serif">Product specs</span> shouldn't be.
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {pains.map((pain, i) => (
        <div class="card card-hover">
          <div class="eyebrow mb-4 text-ink-400">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="h4 mb-3">{pain.heading}</h3>
          <p class="body-sm">{pain.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
