---
// Problem section — the pain before Speclyy
const pains = [
  {
    icon: '📋',
    heading: 'Spec sheets live in a dozen places',
    body: 'Sticky notes, Excel, Programa, email threads. You spend more time hunting for specs than presenting them.',
  },
  {
    icon: '🔗',
    heading: 'Product research is 70% copy-paste',
    body: "You find a Delta faucet you love, then manually transcribe the finish, SKU, and dimensions from the vendor's site. Every. Single. Product.",
  },
  {
    icon: '😤',
    heading: 'Clients ask for updates you can\'t quickly give',
    body: 'The spec sheet is out of date the moment you share it. Changes mean tracking down the original, editing, and re-exporting.',
  },
]
---

<section class="section bg-neutral-50">
  <div class="container-content">

    <div class="max-w-2xl mb-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 mb-3">
        The problem
      </p>
      <h2 class="text-4xl font-bold text-neutral-900 leading-tight">
        Interior design is creative work.<br />
        Product specs shouldn't be.
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {pains.map(pain => (
        <div class="rounded-2xl bg-white p-8 border border-neutral-100 shadow-sm">
          <div class="text-3xl mb-4">{pain.icon}</div>
          <h3 class="text-base font-semibold text-neutral-900 mb-2">{pain.heading}</h3>
          <p class="text-sm text-neutral-500 leading-relaxed">{pain.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
