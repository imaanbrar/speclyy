---
import UrlDemoIsland from '@/components/islands/UrlDemoIsland'
---

<section class="ds-section pb-12 md:pb-16 pt-12 md:pt-20 bg-app">
  <div class="ds-container">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16 items-center">
      <div class="animate-fade-up">
        <p class="eyebrow mb-6">Now in early access</p>

        <h1 class="font-display font-normal text-48 md:text-64 lg:text-80 leading-[1.02] tracking-tighter text-ink-900">
          Spec a project<br />
          <span class="italic-serif text-accent">the way</span> you<br />
          actually work.
        </h1>

        <p class="body-lg mt-8 max-w-[480px]">
          A fast, structured workspace for interior designers. Capture products, organize by room, and export builder-ready spec sheets — without the spreadsheet.
        </p>

        <div class="mt-10 flex items-center gap-4 flex-wrap">
          <a href="https://app.speclyy.com/sign-up" class="btn btn-primary btn-lg">Start 7-day free trial</a>
          <span class="caption">No credit card · cancel anytime</span>
        </div>
      </div>

      <div class="animate-fade-up [animation-delay:120ms]">
        <div class="rounded-lg border border-[color:var(--border-1)] bg-surface p-6 shadow-md">
          <UrlDemoIsland client:visible />
        </div>
      </div>
    </div>

    <div class="mt-16 md:mt-20 flex flex-wrap items-center gap-x-14 gap-y-4 pt-8 border-t border-[color:var(--border-1)]">
      <span class="eyebrow">Built around</span>
      <div class="flex flex-wrap gap-x-10 gap-y-3 font-display text-18 font-medium text-ink-500">
        <span>Kohler</span>
        <span>Delta</span>
        <span>Brizo</span>
        <span>Sherwin-Williams</span>
        <span>Benjamin Moore</span>
      </div>
    </div>
  </div>
</section>
