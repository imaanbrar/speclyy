---
const steps = [
  {
    number: '01',
    heading: 'Paste a product URL.',
    body: "Find a product on Kohler, Delta, Brizo — anywhere. Paste the link into your project. That's it.",
  },
  {
    number: '02',
    heading: 'Speclyy fills in the rest.',
    body: 'We read the page, extract brand, collection, finish options, SKU, dimensions, and product image. No typing.',
  },
  {
    number: '03',
    heading: 'Export a builder-ready spec sheet.',
    body: 'Download a branded PDF or share a live link with the builder. It reads like you spent hours on it.',
  },
]
---

<section id="how-it-works" class="ds-section bg-app">
  <div class="ds-container">
    <div class="max-w-2xl mb-16">
      <p class="eyebrow mb-4">How it works</p>
      <h2 class="h2 md:text-40 lg:text-48">
        From URL to <span class="italic-serif">spec sheet</span> in seconds.
      </h2>
    </div>

    <ol class="grid gap-10 md:grid-cols-3">
      {steps.map(step => (
        <li class="flex flex-col gap-5 pt-6 border-t border-[color:var(--border-2)]">
          <span class="font-display italic text-accent text-48 font-light leading-none">
            {step.number}.
          </span>
          <h3 class="h3">{step.heading}</h3>
          <p class="body-sm max-w-xs">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
