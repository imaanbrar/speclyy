# Copy to .env.local and fill in. Never commit .env.local.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: force a specific model. Default is claude-sonnet-4-6 with
# claude-opus-4-7 as a fallback on parse/schema errors.
# CLAUDE_MODEL=claude-opus-4-7

# =======================================================================
# Zyte API — rendered-fetch fallback
# =======================================================================
# Managed fetch with JS rendering + anti-bot proxy rotation + scriptable
# browser actions (we use `waitForSelector` to wait for client-hydrated
# JSON-LD). Grab a key at https://app.zyte.com/o/
# ZYTE_API_KEY=<your-zyte-api-key>
# USE_ZYTE=1            # set to 0 to disable the rendered fallback
# ZYTE_GEOLOCATION=CA   # optional; default CA. Two-letter ISO country code.
