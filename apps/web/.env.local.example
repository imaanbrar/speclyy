# Supabase — shared auth project (speclyy-auth).
# See docs/operations/infra-provisioning.md for how to provision and where to find each value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never log, never import in a client component.
SUPABASE_SECRET_KEY=

# Database — direct + pooled connection strings for the per-app Postgres (future `speclyy-web` Supabase project, per ADR-0019).
# Not yet provisioned. Leave blank until that project exists; nothing in the auth group reads these.
# See docs/operations/infra-provisioning.md § "Per-app database (future)".
DATABASE_URL=
DATABASE_URL_POOLED=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary — bypasses the onboarding gate so auth can be tested end-to-end
# before the onboarding group ships. Set to 1 locally; delete this var (and
# the `NEXT_PUBLIC_AUTH_BYPASS_ONBOARDING` branches in
# packages/auth/src/{redirect,middleware}.ts) when onboarding Server Actions
# can actually flip `profiles.onboarding_completed_at`.
NEXT_PUBLIC_AUTH_BYPASS_ONBOARDING=1
