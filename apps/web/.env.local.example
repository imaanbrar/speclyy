# Supabase — single project (`speclyy`) holds auth + all app data per ADR-0021.
# See docs/operations/infra-provisioning.md for how to provision and where to find each value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never log, never import in a client component.
SUPABASE_SECRET_KEY=

# Cookie domain for cross-subdomain SSO across `*.speclyy.com` (ADR-0019, cookie part still current).
# Leave blank locally — setting a Domain on `localhost` either breaks the cookie
# or narrows it so http://localhost:3000 can't read it back. In Vercel set this
# to `.speclyy.com` in the Production + Preview scopes.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Stripe — TEST keys in dev/preview, LIVE keys ONLY in production scope.
# See docs/business/stripe-account.md and docs/architecture/operations/stripe-provisioning.md.
STRIPE_SECRET_KEY=                    # sk_test_… (dev/preview) or sk_live_… (prod). Server only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_test_… or pk_live_…. Safe in bundle.
# Webhook signing secret. Different per environment:
#   localhost → output of `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#   preview/prod → Dashboard → Developers → Webhooks → endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs — currency-suffixed from day one (see TASK-BILL-01).
# All four populated even though plans.ts in BILL-01 only reads the USD pair;
# BILL-09 restructures plans.ts to read the CAD pair without an env-var change.
STRIPE_PRICE_ID_PRO_MONTHLY_USD=      # price_…  $37/mo USD
STRIPE_PRICE_ID_PRO_ANNUAL_USD=       # price_…  $348/yr USD ($29/mo billed annually)
STRIPE_PRICE_ID_PRO_MONTHLY_CAD=      # price_…  CA$49/mo
STRIPE_PRICE_ID_PRO_ANNUAL_CAD=       # price_…  CA$468/yr ($39/mo CAD billed annually)

# Stripe Tax automatic calculation. `true` in production (per TASK-BILL-01).
# Leave blank or `false` locally — `automatic_tax: enabled` requires both
# Stripe Tax dashboard configuration AND a customer billing address, which
# the onboarding flow doesn't collect today. The Pro Success path works
# end-to-end with this off; turn it on once Stripe Tax is configured and
# the checkout form collects an address (TASK-BILL-09 cleanup).
STRIPE_AUTOMATIC_TAX=                 # 'true' | 'false' (default false)

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
