# Supabase — single project (`speclyy`) holds auth + all app data per ADR-0021.
# See docs/operations/infra-provisioning.md for how to provision and where to find each value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never log, never import in a client component.
SUPABASE_SECRET_KEY=

# Cookie domain for cross-subdomain SSO across `*.speclyy.com` (ADR-0019, cookie part still current).
# Leave blank locally — setting a Domain on `localhost` either breaks the cookie
# or narrows it so http://localhost:3000 can't read it back. In Vercel set this
# to `.speclyy.com` in the Production + Preview scopes.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
