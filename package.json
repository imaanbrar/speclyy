{
  "name": "speclyy",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:web":        "pnpm --filter @speclyy/web dev",
    "dev:marketing":  "pnpm --filter @speclyy/marketing dev",
    "dev:design":     "pnpm --filter @speclyy/design dev",
    "build:web":      "pnpm --filter @speclyy/web build",
    "build:marketing":"pnpm --filter @speclyy/marketing build",
    "build:design":   "pnpm --filter @speclyy/design build",
    "build":          "pnpm --filter './apps/*' build",
    "scrape":         "pnpm --filter @speclyy/scraper-poc scrape"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
